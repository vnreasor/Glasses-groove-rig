<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Groove Rig</title>
<style>
  :root{
    --bg:#000000;
    --text:#F5F5F0;
    --dim:#8A8A85;
    --accent:#7FB8FF;
    --accent2:#FFC24B;
    --good:#5FD4A0;
    --bad:#E0665A;
    --line:#2A2A28;
    --cell:#1A1A18;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent; user-select:none;}
  html,body{ margin:0; padding:0; height:100%; background:var(--bg); color:var(--text);
    font-family:-apple-system,"SF Pro Text","Segoe UI",Roboto,sans-serif; overflow:hidden; }
  #app{ height:100vh; display:flex; flex-direction:column; }

  .bar{ display:flex; align-items:center; justify-content:space-between; padding:12px 14px 6px; flex-shrink:0; }
  .bar h1{ font-size:16px; font-weight:600; margin:0; }
  .bar .sub{ font-size:12px; color:var(--dim); }

  .tabs{ display:flex; flex:1; min-height:0; }
  .panel{ display:none; flex:1; flex-direction:column; min-height:0; padding:0 12px 8px; }
  .panel.active{ display:flex; }

  .navbar{ display:flex; border-top:1px solid var(--line); flex-shrink:0; }
  .navbtn{ flex:1; border:none; background:none; color:var(--dim); font-size:10.5px; padding:8px 0 10px;
    display:flex; flex-direction:column; align-items:center; gap:3px; }
  .navbtn .ic{ font-size:16px; }
  .navbtn.active{ color:var(--accent); }

  /* ---- Beat panel ---- */
  .transport{ display:flex; align-items:center; justify-content:center; gap:14px; padding:6px 0 10px; flex-shrink:0; }
  .playbtn{ width:52px; height:52px; border-radius:50%; border:2px solid var(--good); color:var(--good);
    background:none; font-size:20px; display:flex; align-items:center; justify-content:center; }
  .playbtn.on{ background:rgba(95,212,160,0.15); }
  .bpmbtn{ border:1px solid var(--line); border-radius:20px; padding:8px 14px; color:var(--text); background:none; font-size:13px; }
  .clearbtn{ border:1px solid var(--line); border-radius:20px; padding:8px 14px; color:var(--bad); background:none; font-size:13px; }

  .grid{ flex:1; overflow-y:auto; display:flex; flex-direction:column; gap:8px; padding-bottom:4px; }
  .row{ display:flex; align-items:center; gap:6px; }
  .rowlabel{ width:44px; font-size:11px; color:var(--dim); flex-shrink:0; }
  .steps{ display:flex; gap:4px; flex:1; }
  .step{ flex:1; aspect-ratio:1; background:var(--cell); border-radius:5px; }
  .step.beat4n{ outline:1px solid rgba(255,255,255,0.06); }
  .step.on{ background:var(--accent); }
  .step.playing{ box-shadow:0 0 0 2px var(--accent2) inset; }

  /* ---- Synth panel ---- */
  .synth-head{ display:flex; align-items:center; justify-content:center; gap:12px; padding:8px 0 14px; flex-shrink:0; }
  .wavebtn{ border:1px solid var(--line); border-radius:20px; padding:8px 16px; color:var(--accent2); background:none; font-size:13px; }
  .keys{ flex:1; display:flex; flex-direction:column; gap:8px; justify-content:center; }
  .keyrow{ display:flex; gap:6px; }
  .key{ flex:1; height:64px; background:var(--cell); border:1px solid var(--line); border-radius:8px;
    display:flex; align-items:flex-end; justify-content:center; padding-bottom:8px; font-size:12px; color:var(--dim); }
  .key.pressed{ background:var(--accent); color:#001428; }
  .synth-hint{ text-align:center; font-size:11px; color:var(--dim); padding-bottom:8px; }

  /* ---- Loop panel ---- */
  .center-col{ flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; text-align:center; }
  .bigcircle{ width:74px; height:74px; border-radius:50%; border:3px solid var(--bad); color:var(--bad);
    background:none; font-size:24px; display:flex; align-items:center; justify-content:center; }
  .bigcircle.recording{ background:rgba(224,102,90,0.15); }
  .status-line{ font-size:13px; color:var(--dim); min-height:18px; }
  .layer-count{ font-size:12px; color:var(--accent2); }
  .looper-controls{ display:flex; gap:14px; padding-top:6px; flex-shrink:0; justify-content:center; flex-wrap:wrap; }
  .pill{ border:1px solid var(--line); border-radius:20px; padding:9px 14px; color:var(--text); background:none; font-size:12.5px; }
  .pill.play{ border-color:var(--good); color:var(--good); }
  .pill.play.on{ background:rgba(95,212,160,0.15); }
  .pill:disabled{ opacity:0.35; }

  /* ---- Vocal panel ---- */
  .vocal-list{ flex:1; overflow-y:auto; padding-top:4px; }
  .take{ display:flex; align-items:center; justify-content:space-between; padding:11px 4px; border-bottom:1px solid var(--line); }
  .take .name{ font-size:14px; }
  .take .len{ font-size:11px; color:var(--dim); }
  .take-actions{ display:flex; gap:10px; }
  .mini{ border:1px solid var(--line); border-radius:16px; padding:6px 12px; font-size:12px; color:var(--text); background:none; }
  .mini.del{ color:var(--bad); border-color:transparent; }
  .empty{ text-align:center; color:var(--dim); font-size:13px; padding:30px 20px; }

  /* ---- Coach panel ---- */
  #coachHome{ flex:1; display:flex; flex-direction:column; min-height:0; }
  #coachLessons{ flex:1; overflow-y:auto; padding-top:2px; }
  .lesson{ padding:12px 6px; border-bottom:1px solid var(--line); display:flex; flex-direction:column; gap:3px; }
  .lesson .name{ font-size:15px; font-weight:600; }
  .lesson .desc{ font-size:12px; color:var(--dim); }
  #coachExercise{ display:none; flex:1; flex-direction:column; min-height:0; text-align:center; }
  #coachExercise.active{ display:flex; }
  .streak{ font-size:11px; color:var(--accent2); margin-bottom:2px; height:14px; }
  .target-wrap{ flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; }
  .target-label{ font-size:11px; color:var(--dim); letter-spacing:0.3px; }
  .target-note{ font-size:48px; font-weight:700; line-height:1; }
  .target-hint{ font-size:12.5px; color:var(--dim); margin-top:2px; min-height:30px; }
  .meter{ width:100%; max-width:240px; height:9px; background:var(--line); border-radius:6px; position:relative; overflow:hidden; margin-top:10px; }
  .meter .zone{ position:absolute; top:0; bottom:0; left:44%; width:12%; background:rgba(95,212,160,0.35); }
  .meter .needle{ position:absolute; top:-3px; width:4px; height:15px; border-radius:2px; background:var(--accent2); left:50%; transform:translateX(-50%); transition:left 0.08s linear; }
  .feedback{ font-size:14px; font-weight:600; min-height:20px; margin-top:10px; }
  .feedback.good{ color:var(--good); }
  .feedback.bad{ color:var(--dim); }
  .coach-controls{ display:flex; align-items:center; justify-content:center; gap:20px; padding:12px 0 4px; flex-shrink:0; }
  .ctrl-btn{ border:none; background:none; color:var(--text); font-size:12px; display:flex; flex-direction:column; align-items:center; gap:5px; }
  .circle{ width:50px; height:50px; border-radius:50%; border:2px solid var(--dim); display:flex; align-items:center; justify-content:center; font-size:19px; }
  .circle.live{ border-color:var(--accent2); background:rgba(255,194,75,0.12); color:var(--accent2); }
  .ctrl-btn.exit .circle{ border-color:var(--bad); color:var(--bad); }
  .ctrl-btn.next .circle{ border-color:var(--good); color:var(--good); }

  .unsupported{ flex:1; display:flex; align-items:center; justify-content:center; text-align:center; color:var(--dim); font-size:14px; padding:0 24px; }
</style>
</head>
<body>
<div id="app">
  <div class="bar">
    <h1 id="panelTitle">Beat</h1>
    <span class="sub" id="panelSub"></span>
  </div>

  <div class="tabs">
    <!-- BEAT -->
    <div class="panel active" id="panel-beat">
      <div class="transport">
        <button class="playbtn" id="beatPlay">▶</button>
        <button class="bpmbtn" id="bpmBtn">100 bpm</button>
        <button class="clearbtn" id="beatClear">Clear</button>
      </div>
      <div class="grid" id="beatGrid"></div>
    </div>

    <!-- SYNTH -->
    <div class="panel" id="panel-synth">
      <div class="synth-head">
        <button class="wavebtn" id="waveBtn">Sine · smooth</button>
      </div>
      <div class="keys" id="synthKeys"></div>
      <div class="synth-hint">Hold a key to sustain the note</div>
    </div>

    <!-- LOOP -->
    <div class="panel" id="panel-loop">
      <div class="center-col">
        <button class="bigcircle" id="loopRecBtn">●</button>
        <div class="status-line" id="loopStatus">Tap to record your first loop</div>
        <div class="layer-count" id="layerCount"></div>
      </div>
      <div class="looper-controls">
        <button class="pill play" id="loopPlayBtn" disabled>Play loop</button>
        <button class="pill" id="loopAddBtn" disabled>Add layer</button>
        <button class="pill" id="loopClearBtn" disabled>Clear</button>
      </div>
    </div>

    <!-- VOCAL -->
    <div class="panel" id="panel-vocal">
      <div class="center-col" style="flex:0 0 auto; padding:12px 0;">
        <button class="bigcircle" id="vocalRecBtn">●</button>
        <div class="status-line" id="vocalStatus">Tap to record a take</div>
      </div>
      <div class="vocal-list" id="vocalList"></div>
    </div>

    <!-- COACH -->
    <div class="panel" id="panel-coach">
      <div id="coachHome">
        <div id="coachLessons"></div>
      </div>
      <div id="coachExercise">
        <div class="streak" id="coachStreak"></div>
        <div class="target-wrap">
          <div class="target-label">SING THIS NOTE</div>
          <div class="target-note" id="coachTargetNote">A3</div>
          <div class="meter"><div class="zone"></div><div class="needle" id="coachNeedle"></div></div>
          <div class="target-hint" id="coachHint">Tap the mic and hold the note</div>
        </div>
        <div class="feedback" id="coachFeedback"></div>
        <div class="coach-controls">
          <button class="ctrl-btn exit" id="coachExitBtn"><div class="circle">✕</div>Quit</button>
          <button class="ctrl-btn" id="coachMicBtn"><div class="circle" id="coachMicCircle">●</div>Sing</button>
          <button class="ctrl-btn next" id="coachNextBtn"><div class="circle">›</div>Skip</button>
        </div>
      </div>
    </div>
  </div>

  <div class="navbar">
    <button class="navbtn active" data-panel="beat"><span class="ic">▦</span>Beat</button>
    <button class="navbtn" data-panel="synth"><span class="ic">♪</span>Synth</button>
    <button class="navbtn" data-panel="loop"><span class="ic">◎</span>Loop</button>
    <button class="navbtn" data-panel="vocal"><span class="ic">●</span>Vocal</button>
    <button class="navbtn" data-panel="coach"><span class="ic">↝</span>Coach</button>
  </div>
</div>

<script>
(function(){
  const hasAudioCtx = !!(window.AudioContext || window.webkitAudioContext);
  const hasMic = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia);
  const hasRecorder = !!window.MediaRecorder;

  if(!hasAudioCtx){
    document.getElementById('app').innerHTML = '<div class="unsupported">Web Audio isn\'t available in this browser view.</div>';
    return;
  }

  let audioCtx = null;
  function ensureCtx(){
    if(!audioCtx){ audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
    if(audioCtx.state === 'suspended'){ audioCtx.resume(); }
    return audioCtx;
  }

  const NOTES = {
    "C3":130.81,"D3":146.83,"E3":164.81,"F3":174.61,"G3":196.00,"A3":220.00,"B3":246.94,
    "C4":261.63,"D4":293.66,"E4":329.63,"F4":349.23,"G4":392.00,"A4":440.00,"B4":493.88,"C5":523.25
  };

  // =========================================================
  // Tab navigation
  // =========================================================
  const TITLES = {
    beat:["Beat","groove box"], synth:["Synth","play a lead"], loop:["Loop","layered looper"],
    vocal:["Vocal","voice takes"], coach:["Coach","pitch training"]
  };
  document.querySelectorAll('.navbtn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      document.querySelectorAll('.navbtn').forEach(b=>b.classList.remove('active'));
      document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
      btn.classList.add('active');
      const key = btn.dataset.panel;
      document.getElementById('panel-'+key).classList.add('active');
      document.getElementById('panelTitle').textContent = TITLES[key][0];
      document.getElementById('panelSub').textContent = TITLES[key][1];
    });
  });

  // =========================================================
  // BEAT — synth drum step sequencer
  // =========================================================
  const TRACKS = ['Kick','Snare','Hat','Clap'];
  const STEPS = 8;
  const pattern = TRACKS.map(()=> new Array(STEPS).fill(false));
  let bpm = 100;
  const BPM_CYCLE = [80,100,120,140];
  let playing = false;
  let currentStep = 0;
  let nextNoteTime = 0;
  let schedulerId = null;
  let noiseBuffer = null;

  function getNoiseBuffer(){
    if(noiseBuffer) return noiseBuffer;
    const ctx = ensureCtx();
    const buf = ctx.createBuffer(1, ctx.sampleRate * 1, ctx.sampleRate);
    const data = buf.getChannelData(0);
    for(let i=0;i<data.length;i++){ data[i] = Math.random()*2-1; }
    noiseBuffer = buf;
    return buf;
  }

  function playKick(t){
    const ctx = ensureCtx();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(150, t);
    osc.frequency.exponentialRampToValueAtTime(40, t+0.15);
    gain.gain.setValueAtTime(1, t);
    gain.gain.exponentialRampToValueAtTime(0.001, t+0.28);
    osc.connect(gain); gain.connect(ctx.destination);
    osc.start(t); osc.stop(t+0.3);
  }
  function playSnare(t){
    const ctx = ensureCtx();
    const noise = ctx.createBufferSource();
    noise.buffer = getNoiseBuffer();
    const bp = ctx.createBiquadFilter();
    bp.type = 'bandpass'; bp.frequency.value = 1800;
    const ng = ctx.createGain();
    ng.gain.setValueAtTime(0.9, t);
    ng.gain.exponentialRampToValueAtTime(0.001, t+0.18);
    noise.connect(bp); bp.connect(ng); ng.connect(ctx.destination);
    noise.start(t); noise.stop(t+0.2);

    const osc = ctx.createOscillator();
    const og = ctx.createGain();
    osc.type='triangle'; osc.frequency.setValueAtTime(180,t);
    og.gain.setValueAtTime(0.5,t); og.gain.exponentialRampToValueAtTime(0.001,t+0.12);
    osc.connect(og); og.connect(ctx.destination);
    osc.start(t); osc.stop(t+0.12);
  }
  function playHat(t){
    const ctx = ensureCtx();
    const noise = ctx.createBufferSource();
    noise.buffer = getNoiseBuffer();
    const hp = ctx.createBiquadFilter();
    hp.type='highpass'; hp.frequency.value = 7000;
    const g = ctx.createGain();
    g.gain.setValueAtTime(0.5,t);
    g.gain.exponentialRampToValueAtTime(0.001,t+0.05);
    noise.connect(hp); hp.connect(g); g.connect(ctx.destination);
    noise.start(t); noise.stop(t+0.06);
  }
  function playClap(t){
    const ctx = ensureCtx();
    [0,0.02,0.04].forEach(off=>{
      const noise = ctx.createBufferSource();
      noise.buffer = getNoiseBuffer();
      const bp = ctx.createBiquadFilter();
      bp.type='bandpass'; bp.frequency.value=1500;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.6, t+off);
      g.gain.exponentialRampToValueAtTime(0.001, t+off+0.1);
      noise.connect(bp); bp.connect(g); g.connect(ctx.destination);
      noise.start(t+off); noise.stop(t+off+0.11);
    });
  }
  const VOICES = [playKick, playSnare, playHat, playClap];

  function renderGrid(){
    const grid = document.getElementById('beatGrid');
    grid.innerHTML = "";
    TRACKS.forEach((name, r)=>{
      const row = document.createElement('div');
      row.className = 'row';
      const label = document.createElement('div');
      label.className = 'rowlabel'; label.textContent = name;
      row.appendChild(label);
      const steps = document.createElement('div');
      steps.className = 'steps';
      for(let c=0;c<STEPS;c++){
        const cell = document.createElement('div');
        cell.className = 'step' + (c%4===0 ? ' beat4n':'');
        cell.dataset.row = r; cell.dataset.col = c;
        cell.addEventListener('click', ()=>{
          pattern[r][c] = !pattern[r][c];
          cell.classList.toggle('on', pattern[r][c]);
        });
        steps.appendChild(cell);
      }
      row.appendChild(steps);
      grid.appendChild(row);
    });
  }

  function scheduler(){
    const ctx = ensureCtx();
    while(nextNoteTime < ctx.currentTime + 0.1){
      TRACKS.forEach((_, r)=>{
        if(pattern[r][currentStep]) VOICES[r](nextNoteTime);
      });
      highlightStep(currentStep);
      const secondsPerStep = 60.0 / bpm / 2;
      nextNoteTime += secondsPerStep;
      currentStep = (currentStep + 1) % STEPS;
    }
    schedulerId = requestAnimationFrame(scheduler);
  }

  function highlightStep(step){
    document.querySelectorAll('#beatGrid .step').forEach(el=>{
      el.classList.toggle('playing', parseInt(el.dataset.col) === step);
    });
  }

  document.getElementById('beatPlay').addEventListener('click', function(){
    const ctx = ensureCtx();
    playing = !playing;
    this.classList.toggle('on', playing);
    this.textContent = playing ? '■' : '▶';
    if(playing){
      currentStep = 0;
      nextNoteTime = ctx.currentTime + 0.05;
      scheduler();
    } else {
      if(schedulerId) cancelAnimationFrame(schedulerId);
      document.querySelectorAll('#beatGrid .step').forEach(el=>el.classList.remove('playing'));
    }
  });

  document.getElementById('bpmBtn').addEventListener('click', function(){
    let idx = BPM_CYCLE.indexOf(bpm);
    bpm = BPM_CYCLE[(idx+1) % BPM_CYCLE.length];
    this.textContent = bpm + ' bpm';
  });

  document.getElementById('beatClear').addEventListener('click', function(){
    pattern.forEach(row => row.fill(false));
    document.querySelectorAll('#beatGrid .step').forEach(el=>el.classList.remove('on'));
  });

  renderGrid();

  // =========================================================
  // SYNTH — playable keyboard
  // =========================================================
  const WAVES = [
    {type:'sine', label:'Sine · smooth'},
    {type:'triangle', label:'Triangle · soft'},
    {type:'sawtooth', label:'Saw · buzzy'},
    {type:'square', label:'Square · chippy'}
  ];
  let waveIdx = 0;
  const activeNotes = {};
  const KEY_NOTES = ["C4","D4","E4","F4","G4","A4","B4","C5"];

  function noteOn(note, keyEl){
    if(activeNotes[note]) return;
    const ctx = ensureCtx();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = WAVES[waveIdx].type;
    osc.frequency.value = NOTES[note];
    gain.gain.setValueAtTime(0, ctx.currentTime);
    gain.gain.linearRampToValueAtTime(0.28, ctx.currentTime + 0.01);
    osc.connect(gain); gain.connect(ctx.destination);
    osc.start();
    activeNotes[note] = {osc, gain};
    if(keyEl) keyEl.classList.add('pressed');
  }
  function noteOff(note, keyEl){
    const active = activeNotes[note];
    if(!active) return;
    const ctx = ensureCtx();
    active.gain.gain.cancelScheduledValues(ctx.currentTime);
    active.gain.gain.setValueAtTime(active.gain.gain.value, ctx.currentTime);
    active.gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.08);
    active.osc.stop(ctx.currentTime + 0.1);
    delete activeNotes[note];
    if(keyEl) keyEl.classList.remove('pressed');
  }

  function renderSynthKeys(){
    const wrap = document.getElementById('synthKeys');
    wrap.innerHTML = "";
    const row1 = document.createElement('div'); row1.className='keyrow';
    const row2 = document.createElement('div'); row2.className='keyrow';
    KEY_NOTES.forEach((note, i)=>{
      const key = document.createElement('div');
      key.className = 'key';
      key.textContent = note;
      const start = (e)=>{ e.preventDefault(); noteOn(note, key); };
      const end = (e)=>{ e.preventDefault(); noteOff(note, key); };
      key.addEventListener('pointerdown', start);
      key.addEventListener('pointerup', end);
      key.addEventListener('pointerleave', end);
      key.addEventListener('pointercancel', end);
      (i < 4 ? row1 : row2).appendChild(key);
    });
    wrap.appendChild(row1); wrap.appendChild(row2);
  }
  renderSynthKeys();

  document.getElementById('waveBtn').addEventListener('click', function(){
    waveIdx = (waveIdx + 1) % WAVES.length;
    this.textContent = WAVES[waveIdx].label;
  });

  // =========================================================
  // Shared mic stream (used by Loop + Vocal + Coach)
  // =========================================================
  let micStream = null;
  async function getMicStream(){
    if(micStream) return micStream;
    if(!hasMic) return null;
    micStream = await navigator.mediaDevices.getUserMedia({ audio:true });
    return micStream;
  }

  function pickMime(){
    if(!hasRecorder) return '';
    const options = ['audio/webm','audio/mp4','audio/ogg'];
    for(const o of options){ if(MediaRecorder.isTypeSupported(o)) return o; }
    return '';
  }

  // =========================================================
  // LOOP — layered looper
  // =========================================================
  const loopRecBtn = document.getElementById('loopRecBtn');
  const loopStatus = document.getElementById('loopStatus');
  const layerCountEl = document.getElementById('layerCount');
  const loopPlayBtn = document.getElementById('loopPlayBtn');
  const loopAddBtn = document.getElementById('loopAddBtn');
  const loopClearBtn = document.getElementById('loopClearBtn');

  if(!hasMic || !hasRecorder){
    document.getElementById('panel-loop').innerHTML = '<div class="unsupported">Mic recording isn\'t supported in this browser view. Open through the Meta AI app for on-device mic access.</div>';
    document.getElementById('panel-vocal').innerHTML = '<div class="unsupported">Mic recording isn\'t supported in this browser view. Open through the Meta AI app for on-device mic access.</div>';
  } else {

    let baseDuration = null;
    let layers = [];
    let loopRecorder = null;
    let loopChunks = [];
    let loopIsRecording = false;
    let loopPlaying = false;
    let activeSources = [];
    let loopAutoStopTimer = null;

    function updateLoopUI(){
      layerCountEl.textContent = layers.length > 0 ? (layers.length + (layers.length===1?' layer':' layers')) : '';
      loopPlayBtn.disabled = layers.length === 0;
      loopAddBtn.disabled = layers.length === 0 || loopIsRecording;
      loopClearBtn.disabled = layers.length === 0;
    }

    async function startLoopRecording(){
      const stream = await getMicStream().catch(()=>null);
      if(!stream){ loopStatus.textContent = "Couldn't access the mic — check permissions"; return; }
      ensureCtx();
      loopChunks = [];
      loopRecorder = new MediaRecorder(stream, pickMime() ? {mimeType:pickMime()} : undefined);
      loopRecorder.ondataavailable = e => { if(e.data.size>0) loopChunks.push(e.data); };
      loopRecorder.onstop = onLoopRecordingStop;
      loopRecorder.start();
      loopIsRecording = true;
      loopRecBtn.classList.add('recording');
      loopStatus.textContent = layers.length===0 ? "Recording your loop length…" : "Recording layer " + (layers.length+1) + "…";
      if(baseDuration){
        loopAutoStopTimer = setTimeout(()=>{ if(loopIsRecording) stopLoopRecording(); }, baseDuration*1000);
      }
    }
    function stopLoopRecording(){
      if(loopAutoStopTimer){ clearTimeout(loopAutoStopTimer); loopAutoStopTimer=null; }
      if(loopRecorder && loopRecorder.state !== 'inactive'){ loopRecorder.stop(); }
      loopIsRecording = false;
      loopRecBtn.classList.remove('recording');
    }
    async function onLoopRecordingStop(){
      const blob = new Blob(loopChunks, {type: pickMime() || 'audio/webm'});
      const arrayBuf = await blob.arrayBuffer();
      try{
        const ctx = ensureCtx();
        const audioBuf = await ctx.decodeAudioData(arrayBuf);
        if(!baseDuration){ baseDuration = audioBuf.duration; }
        layers.push(audioBuf);
        loopStatus.textContent = "Layer " + layers.length + " added";
      }catch(e){
        loopStatus.textContent = "Hmm, that take didn't record cleanly — try again";
      }
      updateLoopUI();
    }
    loopRecBtn.addEventListener('click', ()=>{
      if(loopIsRecording){ stopLoopRecording(); } else { startLoopRecording(); }
    });
    loopAddBtn.addEventListener('click', ()=>{
      if(!loopIsRecording) startLoopRecording();
    });
    function playLoop(){
      const ctx = ensureCtx();
      const startAt = ctx.currentTime + 0.05;
      activeSources = layers.map(buf=>{
        const src = ctx.createBufferSource();
        src.buffer = buf; src.loop = true; src.loopStart = 0; src.loopEnd = baseDuration;
        src.connect(ctx.destination); src.start(startAt);
        return src;
      });
      loopPlaying = true;
      loopPlayBtn.classList.add('on'); loopPlayBtn.textContent = 'Stop loop';
    }
    function stopLoop(){
      activeSources.forEach(src=>{ try{ src.stop(); }catch(e){} });
      activeSources = [];
      loopPlaying = false;
      loopPlayBtn.classList.remove('on'); loopPlayBtn.textContent = 'Play loop';
    }
    loopPlayBtn.addEventListener('click', ()=>{ if(loopPlaying) stopLoop(); else playLoop(); });
    loopClearBtn.addEventListener('click', ()=>{
      stopLoop(); layers = []; baseDuration = null;
      loopStatus.textContent = "Tap to record your first loop";
      updateLoopUI();
    });
    updateLoopUI();

    // =========================================================
    // VOCAL — take recorder
    // =========================================================
    const vocalRecBtn = document.getElementById('vocalRecBtn');
    const vocalStatus = document.getElementById('vocalStatus');
    const vocalList = document.getElementById('vocalList');
    let vocalRecorder = null;
    let vocalChunks = [];
    let vocalIsRecording = false;
    let vocalTakes = [];

    function renderVocalList(){
      vocalList.innerHTML = "";
      if(vocalTakes.length === 0){
        const e = document.createElement('div');
        e.className='empty'; e.textContent = "No takes yet — hit record and sing something.";
        vocalList.appendChild(e);
        return;
      }
      vocalTakes.slice().reverse().forEach((take, ridx)=>{
        const idx = vocalTakes.length - 1 - ridx;
        const row = document.createElement('div');
        row.className = 'take';
        const info = document.createElement('div');
        const name = document.createElement('div'); name.className='name'; name.textContent = take.name;
        const len = document.createElement('div'); len.className='len'; len.textContent = take.buffer.duration.toFixed(1) + 's';
        info.appendChild(name); info.appendChild(len);
        const actions = document.createElement('div'); actions.className = 'take-actions';
        const playBtn = document.createElement('button'); playBtn.className='mini'; playBtn.textContent='Play';
        playBtn.addEventListener('click', ()=>{
          const ctx = ensureCtx();
          const src = ctx.createBufferSource(); src.buffer = take.buffer; src.connect(ctx.destination); src.start();
        });
        const delBtn = document.createElement('button'); delBtn.className='mini del'; delBtn.textContent='Delete';
        delBtn.addEventListener('click', ()=>{ vocalTakes.splice(idx,1); renderVocalList(); });
        actions.appendChild(playBtn); actions.appendChild(delBtn);
        row.appendChild(info); row.appendChild(actions);
        vocalList.appendChild(row);
      });
    }

    async function startVocalRecording(){
      const stream = await getMicStream().catch(()=>null);
      if(!stream){ vocalStatus.textContent = "Couldn't access the mic — check permissions"; return; }
      ensureCtx();
      vocalChunks = [];
      vocalRecorder = new MediaRecorder(stream, pickMime() ? {mimeType:pickMime()} : undefined);
      vocalRecorder.ondataavailable = e => { if(e.data.size>0) vocalChunks.push(e.data); };
      vocalRecorder.onstop = onVocalStop;
      vocalRecorder.start();
      vocalIsRecording = true;
      vocalRecBtn.classList.add('recording');
      vocalStatus.textContent = "Recording…";
    }
    function stopVocalRecording(){
      if(vocalRecorder && vocalRecorder.state !== 'inactive'){ vocalRecorder.stop(); }
      vocalIsRecording = false;
      vocalRecBtn.classList.remove('recording');
    }
    async function onVocalStop(){
      const blob = new Blob(vocalChunks, {type: pickMime() || 'audio/webm'});
      const arrayBuf = await blob.arrayBuffer();
      try{
        const ctx = ensureCtx();
        const audioBuf = await ctx.decodeAudioData(arrayBuf);
        const n = vocalTakes.length + 1;
        vocalTakes.push({ name: "Take " + n, buffer: audioBuf });
        vocalStatus.textContent = "Saved Take " + n;
      }catch(e){
        vocalStatus.textContent = "That take didn't record cleanly — try again";
      }
      renderVocalList();
    }
    vocalRecBtn.addEventListener('click', ()=>{ if(vocalIsRecording) stopVocalRecording(); else startVocalRecording(); });
    renderVocalList();
  }

  // =========================================================
  // COACH — playful pitch-matching lessons
  // =========================================================
  const HYPE_GOOD = ["Nailed it!","Right on the money!","That's the one!","Chef's kiss.","Pitch perfect!","Yes! That's it!","Locked in!","Beautiful."];
  const HYPE_CLOSE = ["So close — nudge it a hair.","Almost! Just a whisper flat.","Right there, just a touch sharp.","Getting warmer!","Ooh, close one."];
  const HYPE_OFF = ["Way off — give it another go.","Not quite, try again!","Missed that one, no worries.","Reset and try again."];
  const LESSONS = [
    { name:"Easy Rider", desc:"Five comfy notes to shake off the rust", seq:["C4","D4","E4","D4","C4"] },
    { name:"Scale Climb", desc:"Walk up a full octave, one step at a time", seq:["C4","D4","E4","F4","G4","A4","B4","C5"] },
    { name:"Low & Slow", desc:"Chesty low notes for warming up the engine", seq:["C3","D3","E3","F3","G3"] },
    { name:"Siren Jumps", desc:"Bounce between wide intervals", seq:["C4","G4","D4","A4","E4"] },
    { name:"High Flyer", desc:"Push gently into your upper range", seq:["G4","A4","B4","C5","B4","A4"] }
  ];

  const coachHome = document.getElementById('coachHome');
  const coachExercise = document.getElementById('coachExercise');
  const coachLessons = document.getElementById('coachLessons');
  const coachTargetNote = document.getElementById('coachTargetNote');
  const coachNeedle = document.getElementById('coachNeedle');
  const coachFeedback = document.getElementById('coachFeedback');
  const coachHint = document.getElementById('coachHint');
  const coachStreak = document.getElementById('coachStreak');
  const coachMicBtn = document.getElementById('coachMicBtn');
  const coachMicCircle = document.getElementById('coachMicCircle');

  let coachLesson = null, coachStepIdx = 0, coachStreakCount = 0;
  let coachListening = false, coachAnalyser = null, coachData = null, coachRaf = null, coachHoldStart = null;

  function pick(arr){ return arr[Math.floor(Math.random()*arr.length)]; }

  function renderCoachHome(){
    coachLessons.innerHTML = "";
    LESSONS.forEach(lesson=>{
      const row = document.createElement('div');
      row.className = 'lesson';
      const name = document.createElement('div'); name.className='name'; name.textContent = lesson.name;
      const desc = document.createElement('div'); desc.className='desc'; desc.textContent = lesson.desc;
      row.appendChild(name); row.appendChild(desc);
      row.addEventListener('click', ()=> startCoachLesson(lesson));
      coachLessons.appendChild(row);
    });
  }

  function startCoachLesson(lesson){
    coachLesson = lesson; coachStepIdx = 0; coachStreakCount = 0;
    coachHome.style.display = 'none';
    coachExercise.classList.add('active');
    showCoachStep();
  }
  function endCoachLesson(){
    stopCoachListening();
    coachExercise.classList.remove('active');
    coachHome.style.display = 'flex';
  }
  function showCoachStep(){
    const noteName = coachLesson.seq[coachStepIdx];
    coachTargetNote.textContent = noteName;
    coachFeedback.textContent = ""; coachFeedback.className = 'feedback';
    coachHint.textContent = "Tap the mic and hold the note";
    coachNeedle.style.left = "50%";
    coachStreak.textContent = coachStreakCount > 1 ? ("🔥 " + coachStreakCount + " in a row") : "";
    coachHoldStart = null;
  }
  function nextCoachStep(){
    coachStepIdx++;
    if(coachStepIdx >= coachLesson.seq.length){
      coachHint.textContent = "Lesson complete — nice work!";
      coachFeedback.textContent = coachStreakCount >= coachLesson.seq.length ? "Flawless round!" : "See you for the next one.";
      coachFeedback.className = 'feedback good';
      stopCoachListening();
      setTimeout(endCoachLesson, 1800);
      return;
    }
    showCoachStep();
  }
  document.getElementById('coachExitBtn').addEventListener('click', endCoachLesson);
  document.getElementById('coachNextBtn').addEventListener('click', ()=>{ coachStreakCount = 0; nextCoachStep(); });

  function autoCorrelate(buf, sampleRate){
    let SIZE = buf.length, rms = 0;
    for(let i=0;i<SIZE;i++){ rms += buf[i]*buf[i]; }
    rms = Math.sqrt(rms/SIZE);
    if(rms < 0.01) return -1;
    let r1=0, r2=SIZE-1, thres=0.2;
    for(let i=0;i<SIZE/2;i++){ if(Math.abs(buf[i])<thres){ r1=i; break; } }
    for(let i=1;i<SIZE/2;i++){ if(Math.abs(buf[SIZE-i])<thres){ r2=SIZE-i; break; } }
    buf = buf.slice(r1,r2); SIZE = buf.length;
    const c = new Array(SIZE).fill(0);
    for(let lag=0; lag<SIZE; lag++){ for(let i=0; i<SIZE-lag; i++){ c[lag] += buf[i]*buf[i+lag]; } }
    let d=0; while(c[d] > c[d+1]) d++;
    let maxval=-1, maxpos=-1;
    for(let i=d;i<SIZE;i++){ if(c[i]>maxval){ maxval=c[i]; maxpos=i; } }
    if(maxpos <= 0) return -1;
    return sampleRate / maxpos;
  }
  function centsOff(freq, targetFreq){ return 1200 * Math.log2(freq/targetFreq); }

  async function startCoachListening(){
    const stream = await getMicStream().catch(()=>null);
    if(!stream){ coachHint.textContent = "Couldn't access the mic — check permissions"; return; }
    const ctx = ensureCtx();
    const src = ctx.createMediaStreamSource(stream);
    coachAnalyser = ctx.createAnalyser();
    coachAnalyser.fftSize = 2048;
    src.connect(coachAnalyser);
    coachData = new Float32Array(coachAnalyser.fftSize);
    coachListening = true;
    coachMicCircle.classList.add('live');
    coachHint.textContent = "Listening…";
    coachLoop();
  }
  function stopCoachListening(){
    coachListening = false;
    coachMicCircle.classList.remove('live');
    if(coachRaf) cancelAnimationFrame(coachRaf);
  }
  coachMicBtn.addEventListener('click', ()=>{
    if(coachListening){ stopCoachListening(); coachHint.textContent = "Paused — tap mic to resume"; }
    else { startCoachListening(); }
  });
  function coachLoop(){
    if(!coachListening) return;
    coachAnalyser.getFloatTimeDomainData(coachData);
    const freq = autoCorrelate(coachData, audioCtx.sampleRate);
    if(freq > 60 && freq < 1200){
      const targetFreq = NOTES[coachLesson.seq[coachStepIdx]];
      const cents = centsOff(freq, targetFreq);
      const clamped = Math.max(-100, Math.min(100, cents));
      coachNeedle.style.left = (50 + clamped/2) + "%";
      const absCents = Math.abs(cents);
      if(absCents < 25){
        if(!coachHoldStart) coachHoldStart = performance.now();
        coachFeedback.textContent = pick(HYPE_GOOD); coachFeedback.className = 'feedback good';
        if(performance.now() - coachHoldStart > 600){
          coachStreakCount++; coachHoldStart = null;
          setTimeout(nextCoachStep, 300);
        }
      } else {
        coachHoldStart = null;
        coachFeedback.textContent = absCents < 60 ? pick(HYPE_CLOSE) : pick(HYPE_OFF);
        coachFeedback.className = 'feedback bad';
      }
    }
    coachRaf = requestAnimationFrame(coachLoop);
  }

  if(!hasMic){
    document.getElementById('panel-coach').innerHTML = '<div class="unsupported">Mic access isn\'t supported in this browser view. Open through the Meta AI app for on-device mic access.</div>';
  } else {
    renderCoachHome();
  }
})();
</script>
